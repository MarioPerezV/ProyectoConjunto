DATABASE_URL=sqlite+aiosqlite:///./app.db
SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Superuser inicial (opcional - solo para desarrollo/testing)
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=admin123

# CORS Configuration
# Separar múltiples orígenes con comas. Use "*" para permitir todos (no recomendado en producción)
CORS_ORIGINS_RAW=http://localhost:5500,http://127.0.0.1:5500
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS_RAW=*
CORS_ALLOW_HEADERS_RAW=*
